# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=replace_me

# ID of the Discord text channel where alerts should be posted
DISCORD_CHANNEL_ID=123456789012345678

# Twitch application credentials from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=replace_me
TWITCH_CLIENT_SECRET=replace_me

# Twitch login names, separated by commas (not display names or full URLs)
TWITCH_CHANNELS=channel_one,channel_two

# Discord server ID; enables the middleman and giveaway slash commands
DISCORD_GUILD_ID=123456789012345678

# Role allowed to claim middleman tickets
MIDDLEMAN_ROLE_ID=123456789012345678

# Optional locations for private tickets and completed-trade logs
# TICKET_CATEGORY_ID=123456789012345678
# TRADE_LOG_CHANNEL_ID=123456789012345678

# Optional: mention this Discord role in each alert
# DISCORD_ROLE_ID=123456789012345678

# Optional: seconds between checks; minimum 30, default 60
# POLL_INTERVAL_SECONDS=60

# Optional for cloud hosting: store notification state on a mounted volume
# STATE_FILE=/data/live-streams.json
# COMMUNITY_STATE_FILE=/data/community.json

# Optional: customize the text above the embed.
# Available placeholders: {name}, {login}, {url}, {title}, {game}
# ALERT_MESSAGE=🔴 **{name} is live on Twitch!**

